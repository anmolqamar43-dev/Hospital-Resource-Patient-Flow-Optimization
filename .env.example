# ==============================================================================
# MetroHealth Multi-Agent Hospital Flow Command System - Environment Variables
# ==============================================================================

# LLM API Keys (Set your API key here for live LLM reasoning)
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: OpenAI API Key (optional)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Configuration
LLM_PROVIDER=gemini           # Options: gemini, openai, heuristic
LLM_MODEL=gemini-2.5-flash     # Options: gemini-2.5-flash, gemini-1.5-flash, gpt-4o-mini

# Server & Autonomous Simulation Settings
PORT=8080
HOST=127.0.0.1
LIVE_SIMULATION_INTERVAL_SEC=4
